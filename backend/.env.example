# Whisper model: small.en (~2GB VRAM), medium.en (~4GB), large-v3 (~6GB float16, ~3GB int8)
WHISPER_MODEL=large-v3
TRANSCRIBE_DEVICE=cuda
# Compute type: empty = auto (float16 GPU, int8 CPU). Use int8 for large-v3 on 8GB GPUs.
WHISPER_COMPUTE_TYPE=int8
DISABLE_LOL_NORMALIZE=0
DISABLE_FUZZY_CORRECT=0
DISABLE_AUDIO_DENOISE=0
DISABLE_SEMANTIC_SEARCH=0
SEMANTIC_SEARCH_THRESHOLD=0.5
HF_TOKEN=hf_your_token_here
NUM_SPEAKERS=
WHISPERX_BATCH_SIZE=4
MIN_CHUNK_MS=2000
WORD_PAUSE_THRESHOLD=1500
# Diarization tuning (all optional, empty = model defaults)
# DIARIZE_MIN/MAX_SPEAKERS override NUM_SPEAKERS when set independently
DIARIZE_MIN_SPEAKERS=
DIARIZE_MAX_SPEAKERS=
DIARIZE_SEGMENTATION_THRESHOLD=
DIARIZE_CLUSTERING_THRESHOLD=
DIARIZE_MIN_DURATION_OFF=
DIARIZE_MIN_DURATION_ON=
ANTHROPIC_API_KEY=
DISABLE_LLM_ANALYSIS=0